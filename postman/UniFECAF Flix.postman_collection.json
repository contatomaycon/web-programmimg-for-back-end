              "    return String(filme.id) === pm.variables.get('filmeSinopseId');",
              "  });",
              "  pm.expect(filmeEsperado).to.exist;",
              "  pm.expect(normalizar(filmeEsperado.sinopse)).to.include(termo);",
              "  pm.expect(normalizar(filmeEsperado.nome)).not.to.include(termo);",
              "  filmes.forEach(function (filme) {",
              "    pm.expect(normalizar(filme.sinopse)).to.include(termo);",
              "  });",
              "});"
            ]
          }
        }
