  "item": [
    {
      "name": "01 Listar filmes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "function normalizar(texto) {",
              "  return String(texto || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();",
              "}",
              "",
              "const filmes = pm.response.json().filmes;",
              "",
              "pm.test('Catálogo retorna filmes com ID, nome e sinopse', function () {",
              "  pm.expect(filmes).to.be.an('array').and.not.empty;",
              "  filmes.forEach(function (filme) {",
              "    pm.expect(filme.id).to.be.a('number').and.above(0);",
              "    pm.expect(Number.isInteger(filme.id)).to.be.true;",
              "    pm.expect(filme.nome).to.be.a('string').and.not.empty;",
              "    pm.expect(filme).to.have.property('sinopse');",
              "  });",
              "  pm.expect(new Set(filmes.map(function (filme) { return filme.id; })).size).to.equal(filmes.length);",
              "});",
              "",
              "if (Array.isArray(filmes) && filmes.length) {",
              "  const titulos = filmes.map(function (filme) { return normalizar(filme.nome); });",
              "  const exemploNome = filmes.find(function (filme) {",
              "    return typeof filme.nome === 'string' && filme.nome.trim().length >= 3;",
              "  });",
              "  if (exemploNome) {",
              "    pm.collectionVariables.set('filmeId', String(exemploNome.id));",
              "    pm.collectionVariables.set('nomeEsperado', exemploNome.nome);",
              "    const palavra = (exemploNome.nome.match(/[\\p{L}\\p{N}]{3,}/gu) || [exemploNome.nome])[0];",
              "    const trecho = palavra.length >= 4 ? palavra.slice(0, -1) : palavra;",
              "    pm.collectionVariables.set('nomeParcial', trecho);",
              "  }",
              "",
              "  let exemploSinopse;",
              "  for (const filme of filmes) {",
              "    const palavras = String(filme.sinopse || '').match(/[\\p{L}]{4,}/gu) || [];",
              "    const palavra = palavras.find(function (termo) {",
              "      return titulos.every(function (titulo) { return !titulo.includes(normalizar(termo)); });",
              "    });",
              "    if (palavra) {",
              "      exemploSinopse = { id: filme.id, palavra: palavra };",
              "      break;",
              "    }",
              "  }",
              "  pm.test('Catálogo oferece um termo exclusivo de sinopse para a verificação', function () {",
              "    pm.expect(exemploSinopse).to.exist;",
              "  });",
              "  if (exemploSinopse) {",
              "    pm.collectionVariables.set('filmeSinopseId', String(exemploSinopse.id));",
              "    pm.collectionVariables.set('termoSinopse', exemploSinopse.palavra);",
              "  }",
              "",
              "  const ids = new Set(filmes.map(function (filme) { return filme.id; }));",
              "  let idAusente = 1;",
              "  while (ids.has(idAusente)) {",
              "    idAusente++;",
              "  }",
              "  pm.collectionVariables.set('idAusente', String(idAusente));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/controle-filmes/filme",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "controle-filmes",
            "filme"
          ]
        },
        "description": "Valida os filmes cadastrados e seleciona exemplos do próprio catálogo."
      },
      "response": []
    },
    {
      "name": "02 Consultar filme por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Filme corresponde ao ID consultado', function () {",
              "  const filme = pm.response.json().filme;",
              "  pm.expect(filme).to.be.an('object');",
              "  pm.expect(filme.id).to.equal(Number(pm.variables.get('filmeId')));",
              "  pm.expect(filme.nome).to.be.a('string').and.not.empty;",
              "  pm.expect(filme).to.have.property('sinopse');",
              "  const nomeEsperado = pm.variables.get('nomeEsperado');",
              "  if (nomeEsperado) {",
              "    pm.expect(filme.nome).to.equal(nomeEsperado);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/controle-filmes/filme/{{filmeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "controle-filmes",
            "filme",
            "{{filmeId}}"
          ]
        },
        "description": "Compara o ID e o nome do detalhe com o filme da listagem."
      },
      "response": []
    },
    {
      "name": "03 Filtrar por trecho do nome",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "function normalizar(texto) {",
              "  return String(texto || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();",
              "}",
              "",
              "pm.test('O trecho do nome encontra o filme do catálogo', function () {",
              "  const filmes = pm.response.json().filmes;",
              "  const termo = normalizar(pm.variables.get('nomeParcial'));",
              "  pm.expect(filmes).to.be.an('array').and.not.empty;",
              "  const filmeEsperado = filmes.find(function (filme) {",
              "    return String(filme.id) === pm.variables.get('filmeId');",
              "  });",
              "  pm.expect(filmeEsperado).to.exist;",
              "  pm.expect(normalizar(filmeEsperado.nome)).to.include(termo);",
              "  filmes.forEach(function (filme) {",
              "    pm.expect(normalizar(filme.nome).includes(termo) ||",
              "      normalizar(filme.sinopse).includes(termo)).to.be.true;",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
