{
  "info": {
    "name": "UniFECAF Flix",
    "description": "Testes locais de listagem, detalhe e filtro do catálogo. Inicie a API com o MySQL carregado e ajuste baseUrl se usar outra porta. Execute a coleção em ordem para selecionar exemplos reais do catálogo. A primeira requisição preenche os valores usados pelas seguintes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Resposta em JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
